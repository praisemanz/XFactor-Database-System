# Copy to .env and fill in. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xfactor
DB_USER=xfactor_app
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

# Optional SELECT-only account used to run LLM-generated SQL on the Ask page
DB_READONLY_USER=xfactor_ro
DB_READONLY_PASSWORD=YOUR_READONLY_PASSWORD_HERE

# Set to 1 when the database requires TLS (most hosted MySQL providers)
DB_SSL=

# Natural-language "Ask" page (https://console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

FLASK_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# When set, creating/editing/deleting rows in the web GUI requires this password
EDIT_PASSWORD=
